# BUILD 60: Exclude old build artifacts from EAS upload
# This reduces upload size from 280 MB → 72.4 MB (74% reduction)

*.aab
*.apk
*.ipa

# Exclude build directories
android/
ios/
.expo/
dist/

# Exclude node_modules (EAS installs fresh)
node_modules/

# Exclude local environment files
.env.local
.env.*.local

# Exclude development artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Exclude OS files
.DS_Store
Thumbs.db
