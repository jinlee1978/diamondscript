# DiamondScript Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Environment (development, staging, production)
EXPO_PUBLIC_ENV=development

# API Configuration
EXPO_PUBLIC_API_URL=https://api.diamondscript.app

# Sentry (Crash Reporting)
# Get your DSN from: https://sentry.io/settings/projects/
EXPO_PUBLIC_SENTRY_DSN=

# RevenueCat (Subscription Management)
# Get your API key from: https://app.revenuecat.com/
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Google Play Store (Android)
# Service account key path for automated submissions
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH=./google-play-service-account.json

# App Store Connect (iOS)
# Used for automated submissions via EAS Submit
APPLE_ID=your-apple-id@example.com
APPLE_TEAM_ID=YOUR_TEAM_ID
ASC_APP_ID=1234567890
