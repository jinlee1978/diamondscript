{
  "name": "diamondscript",
  "version": "1.0.0",
  "main": "node_modules/expo-router/entry.js",
  "description": "DiamondScript — Practice Generator for Baseball Coaches",
  "private": true,
  "scripts": {
    "start": "expo start",
    "test": "jest --coverage",
    "build": "tsc --noEmit",
    "generate-icons": "node scripts/generate-icons.js",
    "prebuild": "npm run generate-icons",
    "ready-check": "node scripts/pre-submit-check.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "clean": "rm -rf android ios dist .expo node_modules && npm install",
    "build:check": "npx expo export",
    "eas-build-pre-install": "npm config set legacy-peer-deps true"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@sentry/react-native": "~7.13.0",
    "@supabase/supabase-js": "^2.95.3",
    "expo": "^54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^9.9.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "expo": {
    "install": {
      "exclude": ["@sentry/react-native"]
    },
    "autolinking": {
      "ios": {
        "searchPaths": [
          "node_modules"
        ]
      },
      "android": {
        "searchPaths": [
          "node_modules"
        ]
      }
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "~19.1.10",
    "dotenv": "^17.2.4",
    "jest": "^29.7.0",
    "sharp": "^0.33.0",
    "supabase": "^2.76.8",
    "ts-jest": "^29.1.0",
    "typescript": "~5.9.2"
  }
}
