{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "resourceClass": "large",
      "cache": {
        "disabled": true
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EAS_BUILD_CACHE_BREAKER": "BUILD_89_PRODUCTION_HARDENED",
        "NODE_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}