{
  "expo": {
    "name": "DiamondScript",
    "slug": "diamondscript",
    "version": "1.1.0",
    "scheme": "diamondscript",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.diamondscript.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "itms-apps"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIDesignRequiresCompatibility": true
      },
      "buildNumber": "4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B4332"
      },
      "package": "com.diamondscript.app",
      "versionCode": 94,
      "permissions": [
        "com.android.vending.BILLING"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 35
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "@sentry/react-native"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6486abad-f7fd-4a97-80ee-cf230466c24c"
      }
    }
  }
}
